{
  "name": "able-pro-vuetify-vuejs",
  "version": "1.2.0",
  "private": true,
  "author": "Phoenixcoded",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build-stage": "vue-tsc --noEmit && vite build --base=/vue/stage/",
    "build-prod": "vue-tsc --noEmit && vite build --base=/vue/",
    "preview": "vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-pattern .gitignore"
  },
  "dependencies": {
    "@eslint/js": "^9.2.0",
    "@fontsource/inter": "5.0.18",
    "@fontsource/poppins": "5.0.14",
    "@fontsource/public-sans": "5.0.18",
    "@fontsource/roboto": "5.0.13",
    "@mdi/js": "^7.4.47",
    "@tiptap/starter-kit": "2.3.1",
    "@tiptap/vue-3": "2.3.1",
    "@tsconfig/node20": "20.1.4",
    "@typescript-eslint/parser": "^7.8.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vuepic/vue-datepicker": "^8.8.1",
    "axios": "^1.7.2",
    "pinia": "2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "resolve-url-loader": "^5.0.0",
    "typescript-eslint": "^7.8.0",
    "vee-validate": "4.12.7",
    "vite-plugin-vuetify": "2.0.3",
    "vue": "3.4.27",
    "vue-i18n": "9.13.1",
    "vue-router": "4.3.2",
    "vue-tabler-icons": "2.21.0",
    "vue-toast-notification": "^3.1.2",
    "vue3-easy-data-table": "^1.5.47",
    "vue3-perfect-scrollbar": "2.0.0",
    "vuetify": "3.6.4",
    "webpack-plugin-vuetify": "3.0.3",
    "yup": "1.4.0"
  },
  "devDependencies": {
    "@types/chance": "1.1.6",
    "@types/node": "20.12.10",
    "@vitejs/plugin-vue": "5.0.4",
    "@vue/eslint-config-prettier": "9.0.0",
    "@vue/tsconfig": "0.5.1",
    "eslint": "8.57.0",
    "eslint-plugin-vue": "9.25.0",
    "prettier": "3.2.5",
    "sass": "1.77.0",
    "sass-loader": "14.2.1",
    "typescript": "5.4.5",
    "vite": "5.2.11",
    "vue-cli-plugin-vuetify": "2.5.8",
    "vue-tsc": "2.0.16"
  }
